# Urban Infrastructure Intelligence Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database Configuration (Supports sqlite:///./urban_infra.db or postgresql+psycopg2://user:pass@localhost:5432/urban_infra)
DATABASE_URL=sqlite:///./urban_infra.db

# Security & JWT
JWT_SECRET=demo_insecure_secret_key_change_in_production_1234567890
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Pilot Area Settings
STUDY_AREA_NAME="Bengaluru Pilot Zones (Koramangala, Indiranagar, HSR)"

# Feature Flags
ENABLE_IMAGE_MODEL=False
ENABLE_SYNTHETIC_DATA_BANNER=True

# Frontend URLs
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
