# PostgreSQL & PostGIS Container Configuration
POSTGRES_DB=urban_infra
POSTGRES_TEST_DB=urban_infra_test
POSTGRES_USER=urban_infra
POSTGRES_PASSWORD=urban_infra_dev_password
POSTGRES_PORT=5432

# Application Database URLs (psycopg driver)
DATABASE_URL=postgresql+psycopg://urban_infra:urban_infra_dev_password@localhost:5432/urban_infra
TEST_DATABASE_URL=postgresql+psycopg://urban_infra:urban_infra_dev_password@localhost:5432/urban_infra_test

# Authentication & JWT Security (override in production)
JWT_SECRET=dev_jwt_secret_placeholder_change_in_production_9988776655
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# Server & Network Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
